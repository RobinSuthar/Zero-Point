generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User { 
  id    String    @id @unique
  name  String? 
  email String  @unique
  image String
  issue Issues[] 
} 


model Issues { 
  issueId      Int      @id @default(autoincrement()) 
  userId        String    
  title     String
  description   String
  picture String?
  //maybe This should be an array of string
  authoritiesTagged String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  issueTimestamp DateTime
  //this could be also array of string ["important", "urgent"]
  label  String
  location String
  author    User    @relation(fields: [userId], references: [id]) 
  //this is basically everytime some increaesed on decrese the issue 
  raisedUp Int
  raisedDown Int
} 